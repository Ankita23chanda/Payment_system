# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-agri-platform-dev-key-change-in-production-123456
ALLOWED_HOSTS=localhost,127.0.0.1


# Database Configuration
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/agri_db
DATABASE_URL=sqlite:///db.sqlite3


# ============================================================
# OTP Configuration
# ============================================================

OTP_PROVIDER=sms

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HOURLY_RATE_LIMIT=5


# ============================================================
# SMS OTP - Twilio
# ============================================================

SMS_PROVIDER=twilio

TWILIO_ACCOUNT_SID=YOUR_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
TWILIO_FROM_NUMBER=YOUR_TWILIO_NUMBER


# ============================================================
# Email OTP Settings
# ============================================================

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=


# ============================================================
# Payment Gateway Configuration
# ============================================================

PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=pk_test_sample_public_key
PAYMENT_SECRET_KEY=sk_test_sample_secret_key