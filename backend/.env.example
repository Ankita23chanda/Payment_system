# ==============================================================================
# Agriculture Products E-Commerce Platform - Environment Configuration
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-agri-platform-dev-key-change-in-production-123456
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL URL, e.g. postgres://user:password@localhost:5432/agri_db)
# If empty or PostgreSQL is unavailable, system gracefully falls back to local sqlite3 for dev.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agri_db

# OTP Configuration
# Options: 'mock' (default for development/testing), 'email', 'sms'
OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Email OTP Settings (Applicable when OTP_PROVIDER=email)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=no-reply@agriproducts.com

# SMS OTP Settings (Applicable when OTP_PROVIDER=sms)
SMS_PROVIDER=mock
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=AGRIMA

# Payment Gateway Configuration
# Options: 'mock' (default development sandbox), 'razorpay', 'stripe'
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=pk_test_sample_public_key
PAYMENT_SECRET_KEY=sk_test_sample_secret_key

# ------------------------------------------------------------------------------
# MANUAL JWT CONFIGURATION (DO NOT EXPOSE TO REACT)
# ------------------------------------------------------------------------------
# The developer will configure their signing secret and cryptographic key here.
# Antigravity does not hard-code or generate JWT secrets.
JWT_SIGNING_KEY=
# ------------------------------------------------------------------------------
